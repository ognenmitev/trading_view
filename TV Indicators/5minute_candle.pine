//@version=5
strategy("Breakout Strategy - Step by Step", overlay=true, max_lines_count=500)

// ============================================
// INPUTS
// ============================================
rejectionTolerance = input.float(0.5, "Rejection Tolerance %", minval=0.1, step=0.1, group="Rejection Levels")
showLabels = input.bool(true, "Show Rejection Labels", group="Display")
showPositionProjection = input.bool(true, "Show Position Projection", group="Display")
showDebugTable = input.bool(true, "Show Debug Info", group="Display")

// ============================================
// TIME MANAGEMENT
// ============================================
// Session definitions (US market times)
isPreMarket = not na(time(timeframe.period, "0400-0930", "America/New_York"))
isRegularHours = not na(time(timeframe.period, "0930-1600", "America/New_York"))
isAfterMarket = not na(time(timeframe.period, "1600-2000", "America/New_York"))

// Detect new trading day
isNewDay = ta.change(time("D")) != 0

// ============================================
// FIRST 5-MINUTE CANDLE TRACKING
// ============================================
var bool isFirst5MinCandle = false
var float first5MinHigh = na
var float first5MinLow = na
var float first5MinOpen = na
var float first5MinClose = na
var int first5MinBarIndex = na
var bool first5MinCaptured = false

// Check if we're on 5-minute timeframe
is5MinChart = timeframe.period == "5"

// Reset at start of new day
if isNewDay
    isFirst5MinCandle := false
    first5MinCaptured := false
    first5MinHigh := na
    first5MinLow := na
    first5MinOpen := na
    first5MinClose := na
    first5MinBarIndex := na

// Detect the first candle of regular hours (9:30 AM)
if isRegularHours and not first5MinCaptured
    if na(first5MinHigh)
        // This is the first bar of regular hours
        isFirst5MinCandle := true
        first5MinHigh := high
        first5MinLow := low
        first5MinOpen := open
        first5MinClose := close
        first5MinBarIndex := bar_index
    else if isFirst5MinCandle
        // Update while first candle is forming
        first5MinHigh := math.max(first5MinHigh, high)
        first5MinLow := math.min(first5MinLow, low)
        first5MinClose := close
        
        // On 5-min chart, close after 1 bar
        if is5MinChart and bar_index > first5MinBarIndex
            isFirst5MinCandle := false
            first5MinCaptured := true

// ============================================
// REJECTION LEVEL DETECTION
// ============================================
var array<float> rejectionLevels = array.new<float>()
var array<int> rejectionCounts = array.new<int>()

// Function to detect if price rejected at current high
isRejection() =>
    // A rejection is when:
    // 1. There's a wick (close is below high)
    // 2. The upper wick is significant (at least 30% of candle range)
    wickSize = high - close
    bodySize = math.abs(close - open)
    totalRange = high - low
    
    hasWick = wickSize > 0
    significantWick = totalRange > 0 and (wickSize / totalRange) >= 0.3
    
    hasWick and significantWick

// Track rejections during pre-market and after-hours
if isPreMarket or isAfterMarket
    if isRejection()
        currentLevel = high
        tolerance = currentLevel * (rejectionTolerance / 100)
        
        // Check if this level already exists in our array
        levelExists = false
        
        if array.size(rejectionLevels) > 0
            for i = 0 to array.size(rejectionLevels) - 1
                existingLevel = array.get(rejectionLevels, i)
                // If current level is within tolerance of existing level
                if math.abs(existingLevel - currentLevel) <= tolerance
                    // Increment the rejection count
                    currentCount = array.get(rejectionCounts, i)
                    array.set(rejectionCounts, i, currentCount + 1)
                    levelExists := true
                    break
        
        // If it's a new level, add it to the array
        if not levelExists
            array.push(rejectionLevels, currentLevel)
            array.push(rejectionCounts, 1)

// Clear rejection levels at the start of each new day
if isNewDay
    array.clear(rejectionLevels)
    array.clear(rejectionCounts)

// ============================================
// PLOT REJECTION LEVELS (2+ rejections minimum)
// ============================================
// Find and plot:
// 1. Most rejected level (highest count)
// 2. Highest rejection level (highest price)
if isRegularHours and array.size(rejectionLevels) > 0
    // Find the level with most rejections
    maxCount = 0
    maxCountLevel = 0.0
    maxCountIndex = -1
    
    for i = 0 to array.size(rejectionLevels) - 1
        count = array.get(rejectionCounts, i)
        if count > maxCount
            maxCount := count
            maxCountLevel := array.get(rejectionLevels, i)
            maxCountIndex := i
    
    // Find the highest rejection level (with 2+ rejections)
    highestLevel = 0.0
    highestCount = 0
    highestIndex = -1
    
    for i = 0 to array.size(rejectionLevels) - 1
        count = array.get(rejectionCounts, i)
        level = array.get(rejectionLevels, i)
        if count >= 2 and level > highestLevel
            highestLevel := level
            highestCount := count
            highestIndex := i
    
    // Plot most rejected level (if 2+ rejections)
    if maxCount >= 2
        line.new(bar_index, maxCountLevel, bar_index + 50, maxCountLevel, extend=extend.right, color=color.red, width=2, style=line.style_dashed)
        if showLabels
            label.new(bar_index + 2, maxCountLevel, "Pre/After Market - Most Rejected (" + str.tostring(maxCount) + "x): " + str.tostring(maxCountLevel, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.normal)
    
    // Plot highest rejection level (if different from most rejected and has 2+ rejections)
    if highestIndex != -1 and highestIndex != maxCountIndex
        line.new(bar_index, highestLevel, bar_index + 50, highestLevel, extend=extend.right, color=color.orange, width=2, style=line.style_dashed)
        if showLabels
            label.new(bar_index + 2, highestLevel, "Pre/After Market - Highest Resistance (" + str.tostring(highestCount) + "x): " + str.tostring(highestLevel, format.mintick), style=label.style_label_left, color=color.orange, textcolor=color.white, size=size.normal)

// ============================================
// POSITION PROJECTION - FIRST 5-MIN CANDLE
// ============================================

if showPositionProjection and not na(first5MinHigh) and not na(first5MinLow) and not isFirst5MinCandle and not na(first5MinBarIndex)
    
    // PURPLE DASHED LINE - HIGH of first 5-min candle
    line.new(bar_index, first5MinHigh, bar_index + 50, first5MinHigh, extend=extend.right, color=color.purple, width=2, style=line.style_dashed)
    label.new(bar_index + 2, first5MinHigh, "1st 5-Min HIGH: " + str.tostring(first5MinHigh, format.mintick), style=label.style_label_left, color=color.purple, textcolor=color.white, size=size.normal)
    
    // PURPLE DASHED LINE - LOW of first 5-min candle
    line.new(bar_index, first5MinLow, bar_index + 50, first5MinLow, extend=extend.right, color=color.purple, width=2, style=line.style_dashed)
    label.new(bar_index + 2, first5MinLow, "1st 5-Min LOW: " + str.tostring(first5MinLow, format.mintick), style=label.style_label_left, color=color.purple, textcolor=color.white, size=size.normal)
        
// Plot the high and low of first 5-min candle as step lines
plot(not na(first5MinHigh) and not isFirst5MinCandle ? first5MinHigh : na, "First 5-Min High", color=color.blue, linewidth=2, style=plot.style_stepline)
plot(not na(first5MinLow) and not isFirst5MinCandle ? first5MinLow : na, "First 5-Min Low", color=color.blue, linewidth=2, style=plot.style_stepline)

// ============================================
// BACKGROUND COLORS FOR SESSIONS
// ============================================
bgcolor(isPreMarket ? color.new(color.orange, 95) : na, title="Pre-Market")
bgcolor(isAfterMarket ? color.new(color.purple, 95) : na, title="After-Market")
bgcolor(isRegularHours ? color.new(color.green, 98) : na, title="Regular Hours")
bgcolor(isFirst5MinCandle ? color.new(color.yellow, 90) : na, title="First 5-Min Candle")

// ============================================
// DEBUG TABLE
// ============================================
if showDebugTable
    var table debugTable = table.new(position.top_right, 2, 10, border_width=1)
    
    if barstate.islast
        table.cell(debugTable, 0, 0, "Timeframe", bgcolor=color.gray, text_color=color.white)
        table.cell(debugTable, 1, 0, timeframe.period, bgcolor=color.gray, text_color=color.white)
        
        table.cell(debugTable, 0, 1, "First 5-Min Detected", bgcolor=color.gray, text_color=color.white)
        table.cell(debugTable, 1, 1, not na(first5MinHigh) ? "YES ✓" : "NO ✗", bgcolor=not na(first5MinHigh) ? color.green : color.red, text_color=color.white)
        
        table.cell(debugTable, 0, 2, "1st 5-Min HIGH", bgcolor=color.purple, text_color=color.white)
        table.cell(debugTable, 1, 2, not na(first5MinHigh) ? str.tostring(first5MinHigh, format.mintick) : "N/A", bgcolor=color.purple, text_color=color.white)
        
        table.cell(debugTable, 0, 3, "1st 5-Min LOW", bgcolor=color.purple, text_color=color.white)
        table.cell(debugTable, 1, 3, not na(first5MinLow) ? str.tostring(first5MinLow, format.mintick) : "N/A", bgcolor=color.purple, text_color=color.white)
        
        table.cell(debugTable, 0, 4, "Total Rejection Levels", bgcolor=color.gray, text_color=color.white)
        table.cell(debugTable, 1, 4, str.tostring(array.size(rejectionLevels)), bgcolor=color.gray, text_color=color.white)
        
        // Find most rejected level info
        mostRejectedPrice = "N/A"
        mostRejectedCount = "N/A"
        if array.size(rejectionLevels) > 0
            maxCount = 0
            maxLevel = 0.0
            for i = 0 to array.size(rejectionLevels) - 1
                count = array.get(rejectionCounts, i)
                if count > maxCount
                    maxCount := count
                    maxLevel := array.get(rejectionLevels, i)
            if maxCount >= 2
                mostRejectedPrice := str.tostring(maxLevel, format.mintick)
                mostRejectedCount := str.tostring(maxCount) + "x"
        
        table.cell(debugTable, 0, 5, "🔴 Most Rejected", bgcolor=color.red, text_color=color.white)
        table.cell(debugTable, 1, 5, mostRejectedPrice + " (" + mostRejectedCount + ")", bgcolor=color.red, text_color=color.white)
        
        // Find highest rejection level info
        highestRejectionPrice = "N/A"
        highestRejectionCount = "N/A"
        if array.size(rejectionLevels) > 0
            highestLevel = 0.0
            highestCount = 0
            for i = 0 to array.size(rejectionLevels) - 1
                count = array.get(rejectionCounts, i)
                level = array.get(rejectionLevels, i)
                if count >= 2 and level > highestLevel
                    highestLevel := level
                    highestCount := count
            if highestCount >= 2
                highestRejectionPrice := str.tostring(highestLevel, format.mintick)
                highestRejectionCount := str.tostring(highestCount) + "x"
        
        table.cell(debugTable, 0, 6, "🟠 Highest Resistance", bgcolor=color.orange, text_color=color.white)
        table.cell(debugTable, 1, 6, highestRejectionPrice + " (" + highestRejectionCount + ")", bgcolor=color.orange, text_color=color.white)
        
        table.cell(debugTable, 0, 7, "Session", bgcolor=color.gray, text_color=color.white)
        sessionText = isPreMarket ? "Pre-Market" : isRegularHours ? "Regular" : isAfterMarket ? "After-Market" : "Closed"
        table.cell(debugTable, 1, 7, sessionText, bgcolor=color.gray, text_color=color.white)
